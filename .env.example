# 复制为 .env 后按需修改。所有值均为本地演示安全的非敏感默认值。
# 注意：Go 程序本身不读取 .env；本项目通过 Makefile（make run / make run-demo-service）
# 在启动前 source 该文件。手动运行时请先 `set -a; source .env; set +a`。
#
# 变量使用 AGENTPERMIT_ 前缀；更名前的 AAD_ / DEMO_ 前缀仍作为兼容别名，
# 新旧同时设置时以 AGENTPERMIT_ 为准。

# ---- 平台（cmd/server，产物名 agentpermit）----
# 监听地址。默认只绑定 loopback；对外部署必须显式修改并配合 HTTPS 反代。
AGENTPERMIT_LISTEN_ADDR=127.0.0.1:8080
# SQLite 数据库路径（自动建库、自动迁移）。
# 未显式配置且存在更名前的旧库 ./data/aad.db 时，将自动沿用旧库。
AGENTPERMIT_DB_PATH=./data/agentpermit.db
# 平台对外地址，用于页面展示 Agent/服务配置示例
AGENTPERMIT_BASE_URL=http://127.0.0.1:8080
# 开放注册。仅限本地演示；对外部署前必须改为 false 并补建账号准入机制。
AGENTPERMIT_ALLOW_REGISTRATION=true
# Cookie Secure 标记。本地 HTTP 演示必须为 false；
# 任何非本机部署都应使用 HTTPS 并改为 true。
AGENTPERMIT_SECURE_COOKIES=false
# 会话有效期
AGENTPERMIT_SESSION_TTL=24h
# 日志级别：debug / info / warn / error
AGENTPERMIT_LOG_LEVEL=info

# ---- 兼容别名（更名前的变量名，可删；与上面同时设置时以 AGENTPERMIT_ 为准）----
# AAD_LISTEN_ADDR=127.0.0.1:8080
# AAD_DB_PATH=./data/aad.db
# AAD_BASE_URL=http://127.0.0.1:8080

# ---- 独立 Demo 机器服务（cmd/demo-machine-service，产物名 agentpermit-demo-machine-service）----
# 平台地址
AGENTPERMIT_BASE_URL=http://127.0.0.1:8080
# 能力所有者在平台网页上获取的 Service Verification Token（敏感，勿提交仓库）
AGENTPERMIT_SERVICE_TOKEN=
# 监听地址
AGENTPERMIT_DEMO_LISTEN_ADDR=127.0.0.1:9090
# 兼容别名：AAD_BASE_URL / AAD_SERVICE_TOKEN / DEMO_LISTEN_ADDR
