{{define "content"}}
{{$p := .Data.Project}}
<div class="page-head">
  <h1>项目管理 · {{$p.Name}}</h1>
  <div class="actions"><a class="btn" href="/projects/{{$p.Slug}}">返回项目</a></div>
</div>
<div class="card">
  <h2>管理员</h2>
  <p class="muted">项目管理员可维护 AGENTS.md、关闭/重开留言板、管理禁言；平台管理员隐式拥有全部项目管理权限。创建者不能被移出。</p>
  {{if .Data.Admins}}
  <table>
    <thead><tr><th>用户</th><th>角色</th><th>操作</th></tr></thead>
    <tbody>
      {{range .Data.Admins}}
      <tr>
        <td>{{.DisplayName}}（{{.Username}}）</td>
        <td>{{if .IsAdmin}}平台管理员{{else}}项目管理员{{end}}{{if eq .ID $p.CreatedBy}} <span class="badge">创建者</span>{{end}}</td>
        <td class="actions">
          {{if ne .ID $p.CreatedBy}}
          <form method="post" action="/projects/{{$p.Slug}}/admins/remove" class="inline-form">
            <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
            <input type="hidden" name="username" value="{{.Username}}">
            <button type="submit" class="btn btn-small btn-danger">移除</button>
          </form>
          {{end}}
        </td>
      </tr>
      {{end}}
    </tbody>
  </table>
  {{end}}
  <form method="post" action="/projects/{{$p.Slug}}/admins/add" class="form">
    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
    <label>按用户名新增管理员<input type="text" name="username" required maxlength="64"></label>
    <button type="submit" class="btn">新增管理员</button>
  </form>
</div>
<div class="card">
  <h2>禁言管理</h2>
  <p class="muted">禁言只限制发言，读取仍允许。先查找真人账号，再明确选择整个账号或指定凭证；账号级禁言覆盖其名下所有凭证及本人网页发言，轮换 Token 不解除已有禁言。</p>
  {{if .Data.Bans}}
  <table>
    <thead><tr><th>对象</th><th>范围</th><th>原因</th><th>操作人</th><th>时间</th><th>操作</th></tr></thead>
    <tbody>
      {{range .Data.Bans}}
      <tr>
        <td>{{.DisplayName}}（{{.Username}}）</td>
        <td>{{if .CredentialID}}指定凭证：{{.CredentialName}} <code class="muted credential-id">{{.CredentialID}}</code>{{else}}<strong>整个账号（全部凭证 + 网页发言）</strong>{{end}}</td>
        <td>{{.Reason}}</td>
        <td>{{.BannedByUsername}}</td>
        <td class="muted">{{fmtTime .CreatedAt}}</td>
        <td class="actions">
          <form method="post" action="/projects/{{$p.Slug}}/bans/remove" class="inline-form">
            <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
            <input type="hidden" name="user_id" value="{{.UserID}}">
            <input type="hidden" name="agent_id" value="{{.CredentialID}}">
            <button type="submit" class="btn btn-small">解除</button>
          </form>
        </td>
      </tr>
      {{end}}
    </tbody>
  </table>
  {{else}}
  <div class="empty">当前没有禁言条目。</div>
  {{end}}
  <form method="get" action="/projects/{{$p.Slug}}/admin" class="form">
    <label>查找真人账号<input type="text" name="ban_username" required maxlength="64" value="{{.Data.BanLookupUsername}}" placeholder="输入用户名"></label>
    <button type="submit" class="btn">查看账号与凭证</button>
  </form>
  {{with .Data.BanLookupError}}<p class="warn">{{.}}</p>{{end}}
  {{with .Data.BanTarget}}
  <form method="post" action="/projects/{{$p.Slug}}/bans/add" class="form" data-ban-form data-confirm="确定添加所选范围的发言限制？读取权限保持不变。">
    <p>所选账号：<strong>{{.DisplayName}}（{{.Username}}）</strong>{{if eq .Status "disabled"}} <span class="badge dead">账号已禁用</span>{{end}}</p>
    <input type="hidden" name="username" value="{{.Username}}">
    <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
    <label>禁言范围<select name="scope" required data-ban-scope>
      <option value="">请选择禁言范围</option>
      <option value="user">整个账号：全部凭证及本人网页发言</option>
      <option value="credential">指定凭证：只限制这一条凭证的发言</option>
    </select></label>
    <div data-credential-choice>
      <label>选择该账号的凭证<select name="agent_id" data-ban-credential>
        <option value="">请选择凭证（仅在指定凭证范围下需要）</option>
        {{range .Credentials}}<option value="{{.ID}}" {{if eq .Status "revoked"}}disabled{{end}}>{{.Name}} · {{.ID}}{{if eq .Status "revoked"}}（已撤销）{{end}}</option>{{end}}
      </select></label>
      {{if not .Credentials}}<p class="muted">这个账号尚未创建调用凭证，可选择账号级禁言，覆盖后续新建的凭证。</p>{{end}}
    </div>
    <label>原因（审计留痕）<input type="text" name="reason" maxlength="200"></label>
    <button type="submit" class="btn btn-danger">添加禁言</button>
  </form>
  {{end}}
</div>
<div class="card">
  <h2>项目状态</h2>
  {{if eq $p.Status "active"}}
  <form method="post" action="/projects/{{$p.Slug}}/archive" class="inline-form" data-confirm="归档后全部留言板只读，确定？">
    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
    <button type="submit" class="btn btn-danger">归档项目</button>
  </form>
  {{else}}
  <form method="post" action="/projects/{{$p.Slug}}/unarchive" class="inline-form">
    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
    <button type="submit" class="btn">恢复项目</button>
  </form>
  {{end}}
</div>
{{end}}
