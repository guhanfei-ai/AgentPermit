{{define "content"}}
{{$v := .Data.Server}}
<div class="page-head"><h1>{{$v.Name}}</h1><a href="/servers" class="btn">返回Server清单</a></div>
<section class="card"><h2>接入详情</h2><table class="kv">
 <tr><th>Server ID</th><td><code class="credential-id">{{$v.ID}}</code></td></tr><tr><th>类型 / 环境</th><td>{{$v.Kind}} / {{$v.Environment}}</td></tr><tr><th>用途</th><td>{{$v.Description}}</td></tr><tr><th>接入地址</th><td>{{$v.Origin}}</td></tr><tr><th>负责人</th><td>{{$v.OwnerName}}</td></tr><tr><th>管理状态</th><td>{{if eq $v.Status "active"}}启用{{else}}停用{{end}}</td></tr><tr><th>最近成功核验</th><td>{{trustTime $v.LastCheckedAt}}</td></tr><tr><th>登记 / 更新</th><td>{{trustTime $v.CreatedAt}} / {{trustTime $v.UpdatedAt}}</td></tr>
</table></section>
<section class="card"><h2>能力契约变量编组</h2><p class="muted">一个Server（服务登记）可挂多个编组。维护者预设字段类型与约束，使用者Agent在签发临时凭证时临时填值；类型校验不构成业务审批。已签发凭证保存定义快照，后续定义变更不影响旧凭证；v1定义变更通过登记新编组表达。</p>
<div class="table-scroll"><table class="responsive-table"><thead><tr><th>编组 / 标识</th><th>说明</th><th>字段定义</th><th>登记人 / 时间</th></tr></thead><tbody>{{range .Data.FieldGroups}}<tr><td data-label="编组 / 标识">{{.Name}}<br><code class="credential-id">{{.ID}}</code></td><td data-label="说明">{{.Description}}</td><td data-label="字段定义"><code class="credential-id" style="white-space:pre-wrap">{{.Definition}}</code></td><td data-label="登记人 / 时间">{{.CreatorName}}<br>{{trustTime .CreatedAt}}</td></tr>{{else}}<tr class="empty-row"><td colspan="4" class="empty">尚未登记变量编组。</td></tr>{{end}}</tbody></table></div>
{{if .User.IsAdmin}}<form method="post" action="/servers/{{$v.ID}}/groups" class="form"><input type="hidden" name="csrf_token" value="{{.CSRFToken}}"><div class="grid-2"><label>编组名称<input name="name" type="text" required maxlength="64"></label><label>说明<input name="description" type="text" maxlength="500"></label></div><label>字段定义（JSON，fields数组；type支持enum/string，enum须给options，string可给max_len，可标required）<textarea name="definition" rows="5" required placeholder='{"fields":[{"key":"ENV","label":"环境","type":"enum","options":["dev","test","prod"],"required":true},{"key":"project","label":"项目名称","type":"string","max_len":64}]}'></textarea></label><button class="btn btn-primary">登记变量编组</button></form>{{end}}
</section>
<section class="card"><h2>接入约定</h2><p>每个受管Request向AgentPermit核验。业务请求保留站点原有认证，临时凭证放在独立请求头：</p><pre class="code">AgentPermit-Temporary-Credential: &lt;临时凭证&gt;</pre><p>Server独立调用 <code>POST /api/v1/service/temporary-credentials/introspect</code>，使用自己的接入凭证作为Bearer认证，JSON正文仅提交 <code>temporary_credential</code>。仅在HTTP 200且active为true时继续处理。</p><p>拒绝、超时或核验不可用时，本次请求不放行。站点原有账号和资源权限继续独立校验。</p></section>
{{if .User.IsAdmin}}<section id="edit" class="card"><h2>编辑与调整</h2><p class="muted">变更接入地址或环境会撤销此Server已有的临时授信，需要重新签发。</p><form method="post" action="/servers/{{$v.ID}}" class="form"><input type="hidden" name="csrf_token" value="{{.CSRFToken}}">{{template "server-fields" .Data}}<button class="btn btn-primary">保存调整</button></form><hr><p>接入凭证：<code>{{$v.TokenHint}}</code></p><form method="post" action="/servers/{{$v.ID}}/rotate" data-confirm="轮换后旧Server接入凭证立即失效，确认继续？"><input type="hidden" name="csrf_token" value="{{.CSRFToken}}"><button class="btn btn-danger">轮换接入凭证</button></form></section>{{end}}
<section class="card"><h2>关联临时授信</h2><div class="table-scroll"><table class="responsive-table"><thead><tr><th>人员 / AI凭证</th><th>编组</th><th>到期时间</th><th>最近核验</th><th>详情</th></tr></thead><tbody>{{range .Data.Grants.Items}}<tr><td data-label="人员 / AI凭证">{{.UserName}} / {{.CredentialName}}</td><td data-label="编组">{{with .GroupName}}{{.}}{{else}}-{{end}}</td><td data-label="到期时间">{{trustTime .EffectiveExpiresAt}}</td><td data-label="最近核验">{{trustTime .LastCheckedAt}}</td><td class="actions" data-label="详情"><a href="/trust/grants/{{.ID}}">查看授信</a></td></tr>{{else}}<tr class="empty-row"><td colspan="5" class="empty">暂无关联授信。</td></tr>{{end}}</tbody></table></div>{{template "trust-pagination" .Data.Grants}}</section>
<link rel="stylesheet" href="/static/trust.css"><script src="/static/trust.js" defer></script>
{{end}}
