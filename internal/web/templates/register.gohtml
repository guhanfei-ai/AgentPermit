{{define "content"}}
<div class="card narrow">
  <h1>注册</h1>
  <form method="post" action="/register" class="form">
    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
    <label>用户名（登录用，字母数字 _ -，3-32 位）<input type="text" name="username" required pattern="[A-Za-z0-9_\-]{3,32}" maxlength="32"></label>
    <label>显示名<input type="text" name="display_name" required maxlength="64"></label>
    <label>密码（8-72 字节）<input type="password" name="password" required minlength="8" maxlength="72" autocomplete="new-password"></label>
    <label>确认密码<input type="password" name="password_confirm" required minlength="8" maxlength="72" autocomplete="new-password"></label>
    <button type="submit" class="btn btn-primary">注册</button>
  </form>
  <p class="muted">已有账号？<a href="/login">登录</a></p>
</div>
{{end}}
