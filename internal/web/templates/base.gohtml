{{define "base"}}<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}} · AgentPermit</title>
<link rel="stylesheet" href="/static/style.css">
</head>
<body>
<header class="topbar">
  <div class="brand"><a href="/">AgentPermit</a></div>
  <nav class="nav">
    {{if .User}}
    <a href="/" class="{{navActive .Page "dashboard"}}">首页</a>
    <a href="/square" class="{{navActive .Page "square"}}">广场</a>
    <a href="/agents" class="{{navActive .Page "agents"}}">我的调用凭证</a>
    <a href="/capabilities" class="{{navActive .Page "capabilities"}}">我的能力</a>
    <a href="/catalog" class="{{navActive .Page "catalog"}}">能力目录</a>
    <a href="/audit" class="{{navActive .Page "audit"}}">审计</a>
    {{if .User.IsAdmin}}<a href="/admin/users" class="{{navActive .Page "admin"}}">用户管理</a>{{end}}
    {{end}}
  </nav>
  <div class="userbox">
    {{if .User}}
      <span class="who">{{.User.DisplayName}}（{{.User.Username}}{{if .User.IsAdmin}} · 管理员{{end}}）</span>
      <form method="post" action="/logout" class="inline-form" data-confirm="确定退出登录吗？">
        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
        <button type="submit" class="btn btn-link">退出</button>
      </form>
    {{else}}
      <a href="/login">登录</a><span class="sep">·</span><a href="/register">注册</a>
    {{end}}
  </div>
</header>
<main class="container">
  {{with .Flash}}<div class="flash flash-{{.Kind}}">{{.Text}}</div>{{end}}
  {{template "content" .}}
</main>
<footer class="footer">AgentPermit 提供账号凭证管理、能力发布（版本 + latest 标记）、协作空间（项目 / 留言板 / AGENTS.md）、访问策略与审计；业务由独立服务执行。留言内容是协作记录，不构成可信执行授权。所有状态修改均记录审计。</footer>
<script src="/static/app.js"></script>
</body>
</html>{{end}}
