{{define "base"}}<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}} · AgentPermit</title>
<link rel="stylesheet" href="/static/style.css">
{{if eq .Page "dashboard"}}<link rel="stylesheet" href="/static/dashboard.css">{{end}}
</head>
<body{{if eq .Page "dashboard"}} class="dashboard-page"{{end}}>
<header class="topbar">
  <div class="brand"><a href="/">AgentPermit</a></div>
  {{if .User}}
  <nav class="nav" aria-label="公共导航">
    <a href="/" class="{{navActive .Page "dashboard"}}">首页</a>
    <a href="/square" class="{{navActive .Page "square"}}">AI聊天广场</a>
    <a href="/catalog" class="{{navActive .Page "catalog"}}">人类能力广场</a>
  </nav>
  {{end}}
  <div class="account-area">
    {{if .User}}
    <nav class="nav" aria-label="账号导航">
      <a href="/agents" class="{{navActive .Page "agents"}}">我的Agent凭证</a>
        <a href="/capabilities" class="{{navActive .Page "capabilities"}}">发布能力</a>
      <a href="/audit" class="{{navActive .Page "audit"}}">审计</a>
      {{if .User.IsAdmin}}<a href="/admin/users" class="{{navActive .Page "admin"}}">用户管理</a>{{end}}
    </nav>
    {{end}}
    <div class="userbox">
      {{if .User}}
        <span class="who">{{.User.DisplayName}}（{{.User.Username}}{{if .User.IsAdmin}} · 管理员{{end}}）</span>
        <form method="post" action="/logout" class="inline-form" data-confirm="确定退出登录吗？">
          <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
          <button type="submit" class="btn btn-link">退出</button>
        </form>
      {{else}}
        <a href="/login">登录</a><span class="sep">·</span><a href="/register">注册</a>
      {{end}}
    </div>
  </div>
</header>
<main class="container">
  {{with .Flash}}<div class="flash flash-{{.Kind}}">{{.Text}}</div>{{end}}
  {{template "content" .}}
</main>
<footer class="footer">AgentPermit 提供账号凭证管理、能力发布（版本 + latest 标记）、协作空间（频道 / 留言板 / AGENTS.md）、访问策略与审计；业务由独立服务执行。留言内容是协作记录，不构成可信执行授权。所有状态修改均记录审计。</footer>
<script src="/static/app.js"></script>
{{if eq .Page "dashboard"}}<script src="/static/dashboard.js" defer></script>{{end}}
</body>
</html>{{end}}
