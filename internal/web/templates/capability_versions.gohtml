{{define "content"}}
{{$c := .Data.Capability}}
<div class="page-head">
  <h1>能力版本 · {{$c.Name}}</h1>
  <div class="actions"><a class="btn" href="/capabilities">返回我的能力</a></div>
</div>
<p class="muted">能力内容（描述、SPEC / 操作手册 RUNBOOK）与工具绑定一起按版本发布：发布生成不可变快照，latest 标记指向对外生效的版本。编辑只改草稿，<strong>不发布不影响 Agent 可见内容</strong>；latest 可回指旧版本实现回滚。内容版本与实时访问控制（黑白名单、启停）相互独立。</p>
<div class="card">
  <h2>当前状态</h2>
  <table class="kv">
    <tr><th>latest 标记</th><td>{{if gt $c.LatestVersion 0}}v{{$c.LatestVersion}}{{else}}尚未发布{{end}}</td></tr>
    <tr><th>草稿状态</th><td>{{if .Data.DraftDirty}}<span class="badge dead">有未发布修改</span>（编辑保存后需发布才对 Agent 生效）{{else}}<span class="badge ok">与 latest 一致</span>{{end}}</td></tr>
  </table>
  <form method="post" action="/capabilities/{{$c.ID}}/publish" class="inline-form" data-confirm="发布会把当前草稿快照为新版本并把 latest 指向它，确定？">
    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
    <button type="submit" class="btn btn-primary">发布当前草稿（并设为 latest）</button>
  </form>
</div>
<div class="card">
  <h2>版本历史</h2>
  {{if .Data.Versions}}
  <table>
    <thead><tr><th>版本</th><th>名称</th><th>发布时间</th><th>发布人</th><th>latest</th><th>操作</th></tr></thead>
    <tbody>
      {{range .Data.Versions}}
      <tr>
        <td>v{{.Version}}</td>
        <td>{{.Name}}</td>
        <td class="muted">{{fmtTime .PublishedAt}}</td>
        <td>{{.PublishedByUsername}}</td>
        <td>{{if eq .Version $c.LatestVersion}}<span class="badge ok">latest</span>{{else}}-{{end}}</td>
        <td class="actions">
          {{if ne .Version $c.LatestVersion}}
          <form method="post" action="/capabilities/{{$c.ID}}/latest" class="inline-form" data-confirm="把 latest 指向旧版本实现内容回滚（访问控制不变），确定？">
            <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
            <input type="hidden" name="version" value="{{.Version}}">
            <button type="submit" class="btn btn-small">设为 latest（回滚）</button>
          </form>
          {{end}}
        </td>
      </tr>
      {{end}}
    </tbody>
  </table>
  <details>
    <summary>查看各版本内容</summary>
    {{range .Data.Versions}}
    <h3>v{{.Version}}{{if eq .Version $c.LatestVersion}}（latest）{{end}}</h3>
    <p class="muted">{{.Description}} · <code>{{.HTTPMethod}} {{.APIPath}}</code> · {{.EndpointURL}}</p>
    <pre class="spec">{{.SpecMarkdown}}</pre>
    {{end}}
  </details>
  {{else}}
  <div class="empty">尚未发布任何版本。</div>
  {{end}}
</div>
{{end}}
