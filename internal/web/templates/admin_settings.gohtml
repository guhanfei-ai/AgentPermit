{{define "content"}}
<h1>系统设置</h1>
<p class="page-description">管理自动化作业的全局控制选项。</p>
<section class="card">
  <h2>全局暂停解锁密码</h2>
  <p class="muted">用于提前解除全局暂停。系统不提供共享初始密码。{{if .Data.Configured}}修改时请输入当前解锁密码。{{else}}首次设置时，请输入当前管理员的登录密码。{{end}}密码为 8–72 字节。</p>
  <form method="post" action="/admin/settings/holiday-unlock-password" class="form">
    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
    <label>{{if .Data.Configured}}当前解锁密码{{else}}当前管理员登录密码{{end}}<input type="password" name="current_password" required maxlength="72" autocomplete="current-password"></label>
    <label>新解锁密码<input type="password" name="password" required minlength="8" maxlength="72" autocomplete="new-password"></label>
    <label>确认新解锁密码<input type="password" name="password_confirm" required minlength="8" maxlength="72" autocomplete="new-password"></label>
    <button type="submit" class="btn btn-primary">保存设置</button>
  </form>
</section>
{{end}}
