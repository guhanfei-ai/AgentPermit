{{define "content"}}
<div class="page-head"><h1>{{.Title}}</h1><a href="/trust" class="btn">返回AI身份授信</a></div>
{{with .Data.Grant}}<section class="card"><table class="kv"><tr><th>授信ID</th><td><code class="credential-id">{{.ID}}</code></td></tr><tr><th>人员</th><td>{{.UserName}}</td></tr><tr><th>原始AI凭证</th><td>{{.CredentialName}} · <code>{{.CredentialID}}</code></td></tr><tr><th>指定Server</th><td>{{.ServerName}} · <code>{{.ServerID}}</code><br>{{.TargetOrigin}}</td></tr><tr><th>变量编组</th><td>{{if .GroupID}}{{.GroupName}} · <code>{{.GroupID}}</code><br><code class="credential-id" style="white-space:pre-wrap">{{.GroupSnapshot}}</code>{{else}}未申报{{end}}</td></tr>{{with $.Data.FieldValues}}<tr><th>申报值</th><td>{{range $k, $v := .}}<code>{{$k}}</code>={{$v}}<br>{{end}}</td></tr>{{end}}<tr><th>签发人 / 时间</th><td>{{.IssuerName}} / {{trustTime .IssuedAt}}</td></tr><tr><th>到期时间</th><td>{{trustTime .EffectiveExpiresAt}}（有效期固定300秒，此为核验承认的到期时间）</td></tr><tr><th>当前状态</th><td>{{trustReason $.Data.Denial}}</td></tr><tr><th>最近成功核验</th><td>{{trustTime .LastCheckedAt}}</td></tr><tr><th>撤销时间</th><td>{{trustTime .RevokedAt}}</td></tr></table>{{if and $.User.IsAdmin .RevokedAt.IsZero}}<form method="post" action="/trust/grants/{{.ID}}/revoke" data-confirm="撤销本条临时授信？"><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><button class="btn btn-danger">撤销授信</button></form>{{end}}</section>{{end}}
{{with .Data.Ban}}<section class="card"><table class="kv"><tr><th>规则名称 / 类型</th><td>{{.Name}} / {{.Kind}}</td></tr><tr><th>人员 / 凭证</th><td>{{.UserName}} / {{.CredentialName}}</td></tr><tr><th>Server / 环境</th><td>{{.ServerName}} / {{.Environment}}</td></tr><tr><th>原因</th><td>{{.Reason}}</td></tr><tr><th>封禁人</th><td>{{.CreatorName}}</td></tr><tr><th>开始 / 截止</th><td>{{trustTime .StartsAt}} / {{if .ExpiresAt.IsZero}}长期{{else}}{{trustTime .ExpiresAt}}{{end}}</td></tr><tr><th>解除时间</th><td>{{trustTime .ReleasedAt}}</td></tr></table>{{if .ReleasedAt.IsZero}}<form method="post" action="/trust/bans/{{.ID}}/release"><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><button class="btn btn-danger">解除本条封禁</button></form>{{end}}</section>
{{if and (eq .Kind "condition") .ReleasedAt.IsZero}}<section class="card"><h2>编辑条件封禁</h2><form method="post" action="/trust/bans/{{.ID}}" class="form"><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><input type="hidden" name="kind" value="condition"><label>名称<input type="text" name="name" required maxlength="128" value="{{.Name}}"></label><label>人员<select name="user_id"><option value="">不限定</option>{{range $.Data.Users}}<option value="{{.ID}}" {{if eq .ID $.Data.Ban.UserID}}selected{{end}}>{{.DisplayName}}</option>{{end}}</select></label><label>AI凭证记录ID（留空不限）<input type="text" name="credential_id" value="{{.CredentialID}}"></label><label>Server<select name="server_id"><option value="">不限</option>{{range $.Data.Servers}}<option value="{{.ID}}" {{if eq .ID $.Data.Ban.ServerID}}selected{{end}}>{{.Name}}</option>{{end}}</select></label><label>环境<input type="text" name="environment" maxlength="64" value="{{.Environment}}"></label><label><input type="checkbox" name="all_scope" value="yes"> 确认允许覆盖全辖区</label><label>原因<textarea name="reason" required maxlength="500">{{.Reason}}</textarea></label><label>开始时间<input type="datetime-local" name="starts_at" step="1" value="{{trustInput .StartsAt}}"></label><label>截止时间（留空长期）<input type="datetime-local" name="expires_at" step="1" value="{{trustInput .ExpiresAt}}"></label><button class="btn btn-primary">保存条件调整</button></form></section>{{end}}{{end}}
{{end}}
